{
  "name": "@alcove/core",
  "version": "0.1.0",
  "description": "Alcove core library: record linkage with private set intersection",
  "license": "Apache-2.0",
  "author": "Vincent Dorie <vdorie@gmail.com>",
  "private": true,
  "type": "module",
  "main": "./dist/core.cjs",
  "module": "./dist/core.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core.esm.js",
      "require": "./dist/core.cjs",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.esm.js",
      "require": "./dist/testing.cjs",
      "types": "./dist/testing.d.ts"
    },
    "./untrusted-text": {
      "import": "./dist/untrusted-text.esm.js",
      "require": "./dist/untrusted-text.cjs",
      "types": "./dist/untrusted-text.d.ts"
    },
    "./websocket-relay": {
      "import": "./dist/websocket-relay.esm.js",
      "require": "./dist/websocket-relay.cjs",
      "types": "./dist/websocket-relay.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin \"@rollup/plugin-typescript={tsconfig:'tsconfig.rollup.json'}\"",
    "clean": "rimraf dist",
    "dev": "rollup -c rollup.config.ts --configPlugin \"@rollup/plugin-typescript={tsconfig:'tsconfig.rollup.json'}\" -w",
    "pretest": "npm run build",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:stress": "vitest run --project stress",
    "precoverage": "npm run build",
    "coverage": "vitest run --project unit --coverage"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@openmined/psi.js": "file:../../lib/openmined-psi.js-2.0.6-seclink.6.tgz",
    "canonicalize": "^5.1.0",
    "eventemitter3": "^5.0.1",
    "loglevel": "^1.9.2",
    "luxon": "^3.7.2",
    "papaparse": "^5.7.0",
    "peerjs-js-binarypack": "2.1.0",
    "re2js": "^2.8.8",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/luxon": "^3.7.6",
    "@types/papaparse": "^5.3.16",
    "rimraf": "^6.0.1",
    "rollup": "^4.65.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.5"
  }
}
