[Unit]
Description=Revoke the Alcove relay's lapsed exchange keys every ten minutes

[Timer]
# A row enrolled without a token lapses 70 minutes after its enrollment, and a
# lapsed row authenticates until the sweep deletes it, so the sweep runs every
# ten minutes: such a row is revoked within about eleven minutes of its lapse.
OnCalendar=*:0/10
RandomizedDelaySec=1m
Persistent=true

[Install]
WantedBy=timers.target
