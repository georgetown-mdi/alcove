# The relay host's one listener on 443/tcp: an nginx stream proxy that reads
# the TLS ClientHello's server name and passes the connection on.
# render-front.sh writes the routes into the maps below and install.sh writes
# the result to /etc/alcove-relay/front.conf.
#
# The first server, on 443, sends every connection on with a PROXY protocol
# header naming the client's address, which nginx sends for a whole server
# block or not at all. A connection asking for the registrar's name goes to the
# registrar's front port, which reads the header. A name ALCOVE_RELAY_FRONT_ROUTES
# lists goes to the route hop on 127.0.0.1:5348, which drops the header and
# passes the connection, TLS unopened, to that route's port.
#
# Every other connection -- the realm's own name, no server name, or bytes that
# are not TLS -- is TURN: the TURN server on 127.0.0.1:5347 terminates its TLS
# under the relay's certificate and passes plain TURN over TCP to coturn's
# tcp-proxy-port, turnserver.conf.tmpl's, with a PROXY header of its own. Its
# set_real_ip_from takes the client's address from the first server's header,
# so the header it sends coturn names the client rather than 127.0.0.1, and
# coturn reports that address to the client.
#
# Where the host runs the WebSocket relay, a connection asking for its name
# goes to the front's WebSocket relay server on 127.0.0.1:5351, which
# terminates its TLS under the relay's certificate and passes the upgrade to
# the relay on loopback, at most 8 at once from one client address.
# scripts/relay-front.test.mjs holds the two files to the same port, and holds
# this file to writing no access log.
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
# Each side of each hop counts one. A TURN, routed-service or WebSocket relay
# client counts four (the 443 server's two sides, then the 5347, 5348 or 5351
# server's), a registrar client two, so 1024 is 256 such clients: six times
# coturn's total-quota of 40 allocations, twice the broker front's 128
# WebSocket clients, and above the WebSocket relay's 72 sockets (48 awaiting
# a hello, 12 pairings of two). The bound on the front's memory.
events { worker_connections 1024; }
stream {
  access_log off;
  map $ssl_preread_server_name $alcove_hop {
    default 127.0.0.1:5347;
    __REGISTRAR_ROUTE__
    __WEBSOCKET_ROUTE__
    __ROUTE_HOPS__
  }
  # Only the names listed here reach the route hop from 443. A connection to
  # it naming another comes from this host, and the TURN server refuses it for
  # want of the header the hop has dropped.
  map $ssl_preread_server_name $alcove_route {
    default 127.0.0.1:5347;
    __ROUTES__
  }
  server {
    listen 443;
    ssl_preread on;
    preread_timeout 10s;
    proxy_connect_timeout 5s;
    # Longer than coturn's max-allocate-lifetime, so an allocation its client
    # refreshes is not cut by the front between refreshes.
    proxy_timeout 900s;
    proxy_protocol on;
    proxy_pass $alcove_hop;
  }
  server {
    listen 127.0.0.1:5347 ssl proxy_protocol;
    set_real_ip_from 127.0.0.1;
    # The certificate certs/deploy-hook.sh deploys, mounted by the front's units.
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    # TLS 1.2 and 1.3, the registrar's floor too; TLS 1.2 with forward-secret
    # AEAD suites only. TLS 1.3's suites are OpenSSL's defaults.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_handshake_timeout 10s;
    proxy_connect_timeout 5s;
    proxy_timeout 900s;
    proxy_protocol on;
    proxy_pass 127.0.0.1:5350;
  }
  server {
    listen 127.0.0.1:5348 proxy_protocol;
    ssl_preread on;
    preread_timeout 10s;
    proxy_connect_timeout 5s;
    proxy_timeout 900s;
    proxy_pass $alcove_route;
  }
  # __WEBSOCKET_SERVER_BEGIN__
  # The WebSocket relay's server, written only where the host names the
  # relay. It sends the relay no PROXY header, which the relay answers 400, so
  # every connection reaches the relay from 127.0.0.1. Its proxy_timeout is
  # 300 s, ten times the relay's 30 s ping (docs/spec/WEBSOCKET_RELAY.md,
  # Keepalive).
  # Each client address holds at most 8 of its connections at once, a further
  # one closed unanswered, and each refusal logged at warn, the level of the
  # front's error log, naming that address. The key is the address
  # set_real_ip_from takes from the header from 443; were it not applied,
  # every client would count as 127.0.0.1, which verify.sh's per-address probe
  # would fail on. verify.sh reads the refusal line by this zone's name.
  limit_conn_zone $binary_remote_addr zone=alcove_websocket_relay:1m;
  server {
    listen 127.0.0.1:5351 ssl proxy_protocol;
    set_real_ip_from 127.0.0.1;
    limit_conn alcove_websocket_relay 8;
    limit_conn_log_level warn;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_handshake_timeout 10s;
    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_pass 127.0.0.1:__WEBSOCKET_PORT__;
  }
  # __WEBSOCKET_SERVER_END__
}
