[Unit]
Description=Install OS updates on the Alcove relay host daily at 08:30 UTC

[Timer]
# After both certificate renewals and before the host pull, in the relay
# host's daily schedule (README.md, The daily schedule).
OnCalendar=*-*-* 08:30:00 UTC
RandomizedDelaySec=0
# Off, so a host that was down at 08:30 does not update at boot, outside the
# schedule; it updates the next day.
Persistent=false

[Install]
WantedBy=timers.target
