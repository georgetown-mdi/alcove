[Unit]
Description=Renew the Alcove relay's TLS certificate by ACME DNS-01
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, failing when it is still held after two
# hours, and stopped at 10 minutes (README.md, The daily schedule). flock's
# wait and timeout bound the run, so the unit sets no start timeout.
ExecStart=/usr/bin/flock -o -w 7200 /run/alcove-maintenance/lock /usr/bin/timeout -k 30 570 /opt/alcove-relay/certs/renew.sh
TimeoutStartSec=infinity
