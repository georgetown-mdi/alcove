[Unit]
Description=Renew the Alcove relay's TLS certificate by ACME DNS-01
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, stopped at 10 minutes (README.md, The
# daily schedule). No start timeout of its own, which would cut short the wait
# for the lock.
ExecStart=/opt/alcove-relay/maintenance-lock.sh 600 /opt/alcove-relay/certs/renew.sh
TimeoutStartSec=infinity
