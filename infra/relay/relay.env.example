# Copy to /etc/alcove-relay/relay.env on the relay host and fill in the realm.
#
#   install -m 600 relay.env.example /etc/alcove-relay/relay.env
#
# install.sh, render-config.sh, render-front.sh, mint-credential.sh and
# verify.sh read this one file, and every one of them refuses to run without
# it. Nothing defaults to
# a hostname: a realm that does not match what mint-credential.sh signs against
# fails every credential, silently, at the moment an exchange needs the relay.

# The relay's publicly resolvable name, which is also coturn's realm and the host
# in the turns: URL a partner is given. One name, three places, one value.
ALCOVE_RELAY_REALM=

# The UDP relay port range, opened inbound and outbound in the instance's
# security group. Wide enough for concurrent allocations, narrow enough to be a
# rule rather than the whole ephemeral range.
ALCOVE_RELAY_MIN_PORT=49152
ALCOVE_RELAY_MAX_PORT=49200

# What a leaked credential is worth inside its one-hour life: concurrent
# allocations per credential, concurrent allocations in total, and the per-session
# rate. The review of each against the largest exchange is in
# docs/notes/webrtc-relay-deployment.md, Quotas against one exchange.
#
# MAX_BPS is bytes a second, for one session, and applies to each direction
# separately: 2000000 is 2 MB/s inbound and 2 MB/s outbound.
#
# The port range above is the other ceiling on concurrent allocations, each of
# which takes a relay port, so a total quota set above the width of that range is
# never the bound that applies -- keep it below, and widen the range first if a
# deployment needs more.
ALCOVE_RELAY_USER_QUOTA=6
ALCOVE_RELAY_TOTAL_QUOTA=40
ALCOVE_RELAY_MAX_BPS=2000000

# The cloud seam: an executable printing "<public>/<private>" on one line.
# aws/external-ip.sh reads IMDSv2; another cloud, or a host with a static
# address, is another script here and no other change in this directory.
ALCOVE_RELAY_EXTERNAL_IP_HELPER=/opt/alcove-relay/aws/external-ip.sh

# Optional. A public address this host can reach, for verify.sh to run a TURN
# allocation's data leg against. Unset, verify.sh probes the allocation only and
# says so.
ALCOVE_RELAY_VERIFY_PEER=

# install.sh writes ALCOVE_RELAY_IMAGE_UID and ALCOVE_RELAY_IMAGE_GID here,
# read from the built image. Do not set them by hand: the ACME deploy hook chowns
# the private key to the uid, the sweep and registrar units run as the pair, and
# a guessed value hands coturn a key or a secrets table it cannot read.

# install.sh writes ALCOVE_RELAY_RUNTIME here too -- podman or docker, whichever
# this host carries -- and reads it back on the next run so a converge does not
# move the relay from one supervisor to the other. verify.sh runs the image on
# it. Set it by hand only to force a runtime the detection would not pick.

# Optional. Overrides the TCP connect target verify.sh's probes use, while the
# realm still names the SNI and TURN realm in every probe. install.sh sets this
# to the instance's private address for its own end-of-install run, because EC2
# does not hairpin an instance's traffic back to its own Elastic IP; leave it
# unset for the daily timer, which should fail if the public path breaks.
ALCOVE_RELAY_VERIFY_CONNECT=

# Optional. Seconds verify.sh retries a TLS handshake through the 443 front
# before its first probe, waiting for a just-(re)started front and coturn
# behind it to come up. Defaults to 30.
ALCOVE_RELAY_VERIFY_WAIT=

# Optional. The TCP port the registrar serves HTTPS on, on a host holding
# /etc/alcove-relay/registrar-token (README.md, The registrar). The 443 front
# reaches it on 127.0.0.1 at this port. Open it in the instance's security
# group only for a client still configured with this port. Defaults to 8443
# where unset; this example sets 8444 because the broker's TLS front
# (infra/broker) holds 8443 on a host that runs it. render-front.sh refuses a
# route to the port the registrar listens on.
ALCOVE_RELAY_REGISTRAR_PORT=8444

# Optional. The registrar's own DNS name, which the 443 front routes to the
# registrar, so a network that allows only 443 out reaches it at
# https://<this name>. Its DNS record points at this host, and the relay's
# certificate is issued for it beside the realm (README.md, The 443 front).
# It cannot be the realm, whose name the front sends to coturn.
ALCOVE_RELAY_REGISTRAR_NAME=
# Optional. The port on 127.0.0.1 where the registrar takes the connections
# the 443 front passes it, each starting with a PROXY protocol header naming
# the client's address. Used only where ALCOVE_RELAY_REGISTRAR_NAME is set.
# Defaults to 8445 where unset.
ALCOVE_RELAY_REGISTRAR_FRONT_PORT=
# Optional. on lets the registrar enroll an exchange for a caller holding no
# token, under a rate limit and a cap on the rows held for each client
# address, and a lapse the registrar fixes (README.md, The registrar); off, or
# unset, requires the relay-owner token for every enrollment. Turning it off is
# a restart of the registrar: systemctl restart alcove-relay-registrar.service.
ALCOVE_RELAY_REGISTRAR_TOKENLESS_ENROLLMENT=
# Optional. The most rows enrolled without a token, not yet lapsed, the
# registrar holds at once; past it, an enrollment without a token of a new id
# is answered 503 and writes nothing. Defaults to 1800 where unset, a bound on
# what each row costs coturn's authentication; keep it well above the total
# quota above times 3.5, the rows use at full relay capacity holds (README.md,
# Enrollment without a token, The ceiling).
ALCOVE_RELAY_REGISTRAR_TOKENLESS_CEILING=

# Optional. Other TLS services on this host the 443 front routes by name, as
# space-separated name=port pairs: a connection naming one is passed,
# unopened, to that port on 127.0.0.1, where the service presents its own
# certificate for the name. The broker's TLS front (infra/broker) is one, for
# example signal.example.org=8443.
ALCOVE_RELAY_FRONT_ROUTES=

# Optional. The AWS region the relay's alarms are in, such as us-west-2. Set,
# install.sh makes one test publish, stopping where it fails or no aws command
# is installed, then enables alcove-relay-metrics.timer, which publishes the
# registrar's counts to CloudWatch there under the instance role, which needs
# the permission aws/provision.md, The instance role, names (README.md,
# Monitoring). Unset, nothing is published.
ALCOVE_RELAY_METRICS_REGION=
