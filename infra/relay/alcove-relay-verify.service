[Unit]
Description=Verify the Alcove relay carries a TURNS allocation
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=alcove-relay.service
Requires=alcove-relay.service

[Service]
Type=oneshot
# Under the host's maintenance lock, failing when it is still held after two
# hours, and stopped at 30 minutes, above the sum of verify.sh's own timeouts
# (README.md, The daily schedule). flock's wait and timeout bound the run, so
# the unit sets no start timeout.
ExecStart=/usr/bin/flock -o -w 7200 /run/alcove-maintenance.lock /usr/bin/timeout -k 30 1770 /opt/alcove-relay/verify.sh
TimeoutStartSec=infinity
