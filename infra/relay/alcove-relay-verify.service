[Unit]
Description=Verify the Alcove relay carries a TURNS allocation
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=alcove-relay.service
Requires=alcove-relay.service

[Service]
Type=oneshot
# Under the host's maintenance lock, stopped at 30 minutes, above the sum of
# verify.sh's own timeouts (README.md, The daily schedule). No start timeout of
# its own, which would cut short the wait for the lock.
ExecStart=/opt/alcove-relay/maintenance-lock.sh 1800 /opt/alcove-relay/verify.sh
TimeoutStartSec=infinity
