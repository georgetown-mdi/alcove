[Unit]
Description=Upgrade the host to the newest Amazon Linux 2023 release
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Amazon Linux 2023 locks dnf to the release the host was launched from.
# --releasever=latest upgrades every package to the newest release, so the host
# stays on one published package set, and moves the lock forward with it, so
# install.sh's own dnf calls follow.
# Under the host's maintenance lock, failing when it is still held after two
# hours, and stopped at 1 hour, so a download that hangs does not hold the unit
# active (README.md, The daily schedule). The daily verification runs after it
# and the host pull.
ExecStart=/usr/bin/flock -o -w 7200 /run/alcove-maintenance/lock /usr/bin/timeout -k 30 3570 /usr/bin/dnf -y upgrade --releasever=latest
# flock's wait and timeout bound the run, so the unit sets no start timeout.
TimeoutStartSec=infinity
