# Quadlet unit for the relay host's 443 front, used where the host has podman.
# install.sh puts this at /etc/containers/systemd/alcove-relay-front.container,
# where podman's systemd generator turns it into alcove-relay-front.service at
# daemon-reload.
#
# PAIRED WITH alcove-relay-front-docker.service, which install.sh uses instead
# on a host that has docker and no podman. The two carry the same image, the
# same mounts, and the same container flags; edit them together.

[Unit]
Description=alcove relay front (nginx stream, 443/tcp)
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
After=network-online.target alcove-relay.service
Wants=network-online.target

[Container]
ContainerName=alcove-relay-front
# The tag install.sh builds from front/Dockerfile, where the digest is pinned.
Image=localhost/alcove-relay-front:installed
Network=host
Volume=/etc/alcove-relay/front.conf:/etc/nginx/nginx.conf:ro
# The relay's certificate, for the TURN server's TLS. Owned by root, which
# nginx's master reads it as with every capability dropped.
Volume=/etc/alcove-relay/certs:/etc/nginx/certs:ro
ReadOnly=true
Tmpfs=/tmp
# nginx's master binds 443 and starts its worker as the image's nginx user.
DropCapability=ALL
AddCapability=NET_BIND_SERVICE SETUID SETGID
LogDriver=journald

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
