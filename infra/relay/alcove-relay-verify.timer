[Unit]
Description=Verify the Alcove relay daily

[Timer]
# A standing relay is idle between exchanges, so nothing else notices that it
# stopped carrying allocations until a partner is waiting on one. The daily run
# is what turns a silent break -- an expired certificate, a lost external
# address, a denied-peer rule that stopped applying -- into a failed unit. Last
# in the relay host's daily schedule, after every job that can restart a
# service (README.md, The daily schedule).
OnCalendar=*-*-* 10:30:00 UTC
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
