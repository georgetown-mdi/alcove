# The relay host's 443 front on a host that runs docker rather than podman.
# install.sh puts this at /etc/systemd/system/alcove-relay-front.service.
#
# PAIRED WITH alcove-relay-front.container, the podman Quadlet unit. The two
# carry the same image, the same mounts, and the same container flags; edit them
# together. The directive-to-flag mapping is the one alcove-relay-docker.service
# states.
#
# The front reads the server name from a connection's first bytes and passes
# the connection to the registrar or a routed service on loopback, TLS
# unopened, or terminates a TURN client's TLS under the relay's certificate
# and passes plain TURN to coturn (README.md, The 443 front). The certificate
# is owned by root, which nginx's master reads it as with every capability
# dropped.

[Unit]
Description=alcove relay front (nginx stream, 443/tcp)
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md
Requires=docker.service
After=docker.service network-online.target alcove-relay.service
Wants=network-online.target

[Service]
ExecStartPre=-/usr/bin/docker rm -f alcove-relay-front
# nginx's master binds 443 and starts its worker as the image's nginx user.
ExecStart=/usr/bin/docker run --rm --name alcove-relay-front \
  --network host \
  --read-only --tmpfs /tmp \
  --cap-drop ALL --cap-add NET_BIND_SERVICE --cap-add SETUID --cap-add SETGID \
  --log-driver journald \
  -v /etc/alcove-relay/front.conf:/etc/nginx/nginx.conf:ro \
  -v /etc/alcove-relay/certs:/etc/nginx/certs:ro \
  localhost/alcove-relay-front:installed
ExecStop=-/usr/bin/docker stop alcove-relay-front
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
