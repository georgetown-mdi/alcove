[Unit]
Description=Bring the Alcove relay host to the tip of main daily at 09:30 UTC

[Timer]
# After the relay's OS update and before the daily verification, in the relay
# host's daily schedule (infra/relay/README.md, The daily schedule).
OnCalendar=*-*-* 09:30:00 UTC
RandomizedDelaySec=0
# Off, so a host that was down at 09:30 does not install at boot, outside the
# schedule; it pulls the next day.
Persistent=false

[Install]
WantedBy=timers.target
