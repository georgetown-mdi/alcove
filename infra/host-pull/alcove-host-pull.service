[Unit]
Description=Bring the Alcove relay host to the tip of main
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/host-pull/README.md
After=network-online.target alcove-relay-os-update.service
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, failing when it is still held after two
# hours, and stopped at 1 hour, so a fetch or an image build that hangs does
# not hold the unit active (infra/relay/README.md, The daily schedule). The
# lock is apart from pull.sh's own, which keeps two pulls from overlapping.
ExecStart=/usr/bin/flock -o -w 7200 /run/alcove-maintenance/lock /usr/bin/timeout -k 30 3570 /opt/alcove-host-pull/pull.sh
# npm and git as root read their configuration from here.
Environment=HOME=/root
StateDirectory=alcove-host-pull
StateDirectoryMode=0755
# flock's wait and timeout bound the run, so the unit sets no start timeout.
TimeoutStartSec=infinity
