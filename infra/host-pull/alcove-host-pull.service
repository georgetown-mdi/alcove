[Unit]
Description=Bring the Alcove relay host to the tip of main
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/host-pull/README.md
After=network-online.target alcove-relay-os-update.service
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, stopped at 1 hour, so a fetch or an image
# build that hangs does not hold the unit active (infra/relay/README.md, The
# daily schedule).
ExecStart=/opt/alcove-host-pull/maintenance-lock.sh 3600 /opt/alcove-host-pull/pull.sh
# npm and git as root read their configuration from here.
Environment=HOME=/root
StateDirectory=alcove-host-pull
StateDirectoryMode=0755
# No start timeout of its own, which would cut short the wait for the lock.
TimeoutStartSec=infinity
