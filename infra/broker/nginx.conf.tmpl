# The broker's TLS front. render-config.sh substitutes __ALCOVE_BROKER_NAME__
# into /etc/alcove-broker/nginx.conf.
#
# The access log names the request path and never the query string: a signaling
# URL's query contains the rendezvous identifier and the client token.
# scripts/broker-front.test.mjs fails if a log format here writes it.
#
# The error log is at crit because nginx writes the request line, query string
# included, into an error or warn line about a request. The access log's
# upstream fields show what the broker did with a request instead.
worker_processes 1;
error_log /dev/stderr crit;
pid /tmp/nginx.pid;
events { worker_connections 256; }
http {
  log_format conn '$time_iso8601 $remote_addr "$request_method $uri $server_protocol" $status upgrade=$http_upgrade bytes=$bytes_sent dur=$request_time request_bytes=$request_length upstream_status=$upstream_status upstream_connect=$upstream_connect_time upstream_dur=$upstream_response_time';
  access_log /dev/stdout conn;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server_tokens off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8443 ssl;
    server_name __ALCOVE_BROKER_NAME__;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_header_timeout 30s;
    send_timeout 30s;
    location /api/ {
      proxy_pass http://127.0.0.1:9411;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_read_timeout 300s;
    }
    location / { return 404; }
  }
}
