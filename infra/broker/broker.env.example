# Copy to /etc/alcove-broker/broker.env on the broker host and fill it in.
#
#   install -m 600 broker.env.example /etc/alcove-broker/broker.env
#
# Nothing here defaults to a hostname: install.sh, render-config.sh and
# renew.sh refuse to run without the name.

# The DNS name the front serves and the certificate is issued for. Its record
# points at this host and is DNS-only: a proxying CDN would end TLS before the
# front does.
ALCOVE_BROKER_NAME=

# The ACME contact, the DNS provider and the provider credential. The default is
# the relay's file on the same host (infra/relay/certs/env.example), whose
# zone-scoped token covers this name too. renew.sh drives lego only.
#ALCOVE_BROKER_ACME_ENV=/etc/alcove-relay/acme.env
