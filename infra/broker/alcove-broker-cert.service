[Unit]
Description=Renew the alcove standalone broker's TLS certificate by ACME DNS-01
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, stopped at 10 minutes
# (infra/relay/README.md, The daily schedule). No start timeout of its own,
# which would cut short the wait for the lock.
ExecStart=/etc/alcove-broker/maintenance-lock.sh 600 /etc/alcove-broker/renew.sh
TimeoutStartSec=infinity
