[Unit]
Description=Renew the alcove standalone broker's TLS certificate by ACME DNS-01
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Under the host's maintenance lock, failing when it is still held after two
# hours, and stopped at 10 minutes (infra/relay/README.md, The daily
# schedule). flock's wait and timeout bound the run, so the unit sets no start
# timeout.
ExecStart=/usr/bin/flock -o -w 7200 /run/alcove-maintenance/lock /usr/bin/timeout -k 30 570 /etc/alcove-broker/renew.sh
TimeoutStartSec=infinity
