{
  "name": "alcove-web",
  "version": "0.0.0",
  "private": true,
  "description": "Alcove web app: private set intersection for record linkage over peer-to-peer connections.",
  "license": "Apache-2.0",
  "author": "Vincent Dorie <vdorie@gmail.com>",
  "type": "module",
  "main": "index.tsx",
  "scripts": {
    "dev": "vite dev",
    "dev:console": "VITE_DEPLOYMENT_PROFILE=console node server/console/dev.ts",
    "build": "VITE_DEPLOYMENT_PROFILE=hosted vite build --config vite.hosted.config.ts",
    "build:console": "VITE_DEPLOYMENT_PROFILE=console vite build --config vite.console.config.ts",
    "build:console-server": "VITE_DEPLOYMENT_PROFILE=console vite build --config vite.console.config.ts --ssr server/console/main.ts",
    "lint": "npx eslint src server hosted vite.hosted.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:interop": "vitest run --project interop",
    "test:live-webrtc": "vitest run --project live-webrtc",
    "test:integration:browser": "vitest run --project integration --project browser",
    "coverage": "vitest run --project unit --project browser --coverage"
  },
  "keywords": [
    "private set intersection",
    "record linkage"
  ],
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dropzone": "^9.7.3",
    "@mantine/hooks": "^9.5.0",
    "@openmined/psi.js": "file:../../lib/openmined-psi.js-2.0.6-seclink.6.tgz",
    "@alcove/cli-contract": "file:../../packages/cli-contract",
    "@alcove/core": "file:../../packages/core",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "env-schema": "^8.0.1",
    "loglevel": "^1.9.2",
    "peerjs": "1.5.5",
    "peerjs-js-binarypack": "2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alcove/peerjs-broker": "file:../../packages/peerjs-broker",
    "@alcove/testkit": "file:../../packages/testkit",
    "@alcove/websocket-relay": "file:../../packages/websocket-relay",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/object-assign": "^4.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vary": "^1.1.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint-visitor-keys": "^5.0.1",
    "playwright": "^1.64.1",
    "postcss-preset-mantine": "^1.18.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
